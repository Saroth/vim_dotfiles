{
  "suggest": {
    "__tip_0": "// 默认不选中补全项",
    "noselect": true
  },
  "semanticTokens": {
    "__tip_0": "// 启用语法高亮",
    "enable": true
  },
  "diagnostic": {
    "__tip_0": "// 关闭自动诊断，改为在写入文件时",
    "autoRefresh": false,
    "__tip_1": "// 关闭诊断标志，仅显示行号高亮",
    "hintSign": "",
    "infoSign": "",
    "warningSign": "",
    "errorSign": ""
  },
  "colors": {
    "__tip_0": "// coc-highlight: 启用颜色代码高亮",
    "enable": true
  },
  "inlayHint.enable": false,
  "java": {
    "__tip_0": "// coc-java: 配置lombok支持",
    "__tip_1": "// XXX: 需要手动下载lombok-{ver}.jar放到:~/.config/coc/extensions/node_modules/coc-java/lombok/目录",
    "jdt.ls.lombokSupport.enabled": true,
    "compile.nullAnalysis.mode": "automatic"
  },
  "sumneko-lua": {
    "enableNvimLuaDev": true
  },
  "snippets.ultisnips.pythonPrompt": false
}
